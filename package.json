{
  "name": "gopher-test",
  "displayName": "Gopher Test",
  "description": "Tests Gophers",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "repository": {
    "url": "https://github.com/DeadlySurgeon/gophertest"
  },
  "categories": [
    "Other"
  ],
  "license": "Apache-2.0",
  "extensionDependencies": [
    "golang.go"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gopher-test.install-tooling",
        "title": "Gopher-Test: Install Tooling"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
